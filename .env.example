# ─────────────────────────────────────────────────────────────
# Royze Party Needs Rental — environment variables
# Copy to .env.local and fill in. Never commit .env.local.
# ─────────────────────────────────────────────────────────────

# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Service-role key — SERVER ONLY, never exposed to the browser.
# Required for owner-driven user management (create staff account,
# reset password, deactivate) and for the seed script.
# Project Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# ── Seeded owner account (used by `npm run seed`) ──
# Change SEED_OWNER_PASSWORD before seeding a real deployment.
# The seeded owner is forced to change this password on first login.
SEED_OWNER_EMAIL=owner@royzepartyneeds.com
SEED_OWNER_PASSWORD=ChangeMe!2026
SEED_OWNER_NAME=Royze Owner

# Set to "true" to also seed a few sample customers and suppliers, so
# those two directories are not empty while you learn the app. Leave it
# out on a real deployment. Staff accounts are created by the owner in
# Settings → Users; the seed script never creates them.
SEED_SAMPLE_CONTACTS=false
